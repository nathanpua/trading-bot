# ─────────────────────────────────────────────────────────────
# Trading Bot — Environment Variables
# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env
# All keys below have FREE tiers — no payment required.
# ─────────────────────────────────────────────────────────────

# Alpaca — broker + market data (REQUIRED)
# Free paper-trading account: https://app.alpaca.markets/paper/dashboard/overview
# Sign up → Paper Trading → Get API Keys
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Finnhub — primary market-data feed: real-time quotes, candles, news (REQUIRED)
# Free tier (~60 req/min): https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage — fallback daily-bar source (OPTIONAL)
# Free tier (25 req/day): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# Supermemory — semantic trade memory (OPTIONAL)
# Without this the bot runs fine; it just skips memory recall/store.
# Free tier: https://supermemory.ai
SUPERMEMORY_API_KEY=your_supermemory_key_here
